# Icthus environment template.
#
# NAMES ONLY. Never commit a real value to this file or any other file in the
# repository. Browser values live in GitHub Actions secrets; server values live
# in Supabase Edge Function secrets and never reach the bundle.

# ---------------------------------------------------------------------------
# Browser (VITE_*) — shipped in the JavaScript bundle, so nothing secret here.
# ---------------------------------------------------------------------------

# The Supabase project URL and anon key. The anon key is a public identifier;
# Row Level Security is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature flags. Anything not explicitly set to `true` stays off, and the UI
# reports the corresponding provider as local or unavailable.
VITE_FEATURE_YOUVERSION=
VITE_FEATURE_GLOO=
VITE_FEATURE_COMPANION_LLM=
VITE_FEATURE_TRANSCRIPTION=
VITE_FEATURE_OCR=
VITE_FEATURE_CONNECTED_DELIVERY=

# ---------------------------------------------------------------------------
# Supabase Edge Function secrets — set with `supabase secrets set`, never here.
# ---------------------------------------------------------------------------

# Provided automatically by the Edge runtime:
#   SUPABASE_URL
#   SUPABASE_ANON_KEY
#   SUPABASE_SERVICE_ROLE_KEY

# Comma-separated list of origins allowed to call the functions.
ICTHUS_ALLOWED_ORIGINS=

# Shared secret proving a request came from the scheduler, not the public web.
ICTHUS_SCHEDULER_SECRET=

# How wide a window (in minutes) a scheduled job treats as "due".
ICTHUS_DISPATCH_WINDOW_MINUTES=

# YouVersion Platform — https://platform.youversion.com/platform/get-started
YOUVERSION_APP_ID=
YOUVERSION_API_KEY=
YOUVERSION_API_BASE_URL=
YOUVERSION_DEFAULT_VERSION_ID=

# Gloo AI Studio (OAuth 2.0 client credentials) — https://studio.ai.gloo.com/
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_TOKEN_URL=
GLOO_API_BASE_URL=
GLOO_SCOPES=

# Connected delivery providers. Absent means the route reports
# `provider_unavailable` rather than pretending to send.
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
NOTION_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Optional server-side model for the companion adapter.
COMPANION_MODEL_API_KEY=
COMPANION_MODEL_BASE_URL=
COMPANION_MODEL_NAME=

# Optional transcription provider.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_ENDPOINT=
